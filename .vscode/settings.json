{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "project.json": "package.json, prettier.config.mts, .oxlintrc.json, .oxfmtrc.json, .npm*, jest*, nx.json, pnpm-lock.yaml, tsconfig*, angular.json, ng-package.json, playwright*",
    "package.json": "prettier.config.mts, .oxlintrc.json, .oxfmtrc.json, .npm*, jest*, nx.json, pnpm-lock.yaml, tsconfig*, angular.json, ng-package.json, playwright*, .markdownlint.jsonc",
    "*.ts": "$(capture).spec.ts, $(capture).test.ts, $(capture).d.ts, $(capture).js, $(capture).js.map, $(capture).ts.map",
    "*.js": "$(capture).d.ts, $(capture).js.map",
    "*.css": "$(capture).css.map"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always",
    "source.removeUnusedImports": "never"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.cache": true,
    "**/dist": true,
    "**/coverage": true,
    "pnpm-lock.yaml": true
  },
  "js/ts.preferences.importModuleSpecifier": "project-relative",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "deno.enable": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "task.autoDetect": "off",
  // Remove comments if branch policies are used
  // "git.branchProtection": ["main", "master"],
  // "git.branchProtectionPrompt": "alwaysPrompt",
  "tailwindCSS.experimental.configFile": "apps/docs/src/styles.scss",
  "coverage-gutters.coverageBaseDir": "**/coverage/**"
}

{
  "name": "@ngneers/controls-themes",
  "version": "0.0.1-next.5",
  "description": "Theme presets and the theming engine for @ngneers/controls (Nova, Shade, Material, and base themes).",
  "license": "MIT",
  "homepage": "https://ngneers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NGneers/controls.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "angular",
    "components",
    "ui",
    "theme",
    "theming",
    "design-system",
    "ngneers-controls"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm rimraf ./dist",
    "postbuild": "tsx ./tools/post-build.ts",
    "build": "pnpm prebuild && tsc -p ./tsconfig.lib.json --outDir ./dist && pnpm postbuild"
  },
  "type": "module",
  "dependencies": {
    "@ngneers/controls-custom-types": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "catalog:"
  },
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts"
}

{
  "name": "@awdlab/jig-themes",
  "version": "0.0.4",
  "description": "Theme presets and the theming engine for @awdlab/jig (Nova, Shade, Material, and base themes).",
  "license": "MIT",
  "homepage": "https://jig.awdlab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awdlab/jig.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "angular",
    "components",
    "ui",
    "theme",
    "theming",
    "design-system",
    "jig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm rimraf ./dist",
    "postbuild": "tsx ./tools/post-build.ts",
    "build": "pnpm prebuild && tsc -p ./tsconfig.lib.json --outDir ./dist && pnpm postbuild"
  },
  "type": "module",
  "dependencies": {
    "@awdlab/jig-custom-types": "workspace:*",
    "tslib": "^2.8.1"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nova": {
      "types": "./dist/nova/typed.d.ts",
      "import": "./dist/nova/index.js"
    },
    "./nova/untyped": {
      "types": "./dist/nova/index.d.ts",
      "import": "./dist/nova/index.js"
    },
    "./shade": {
      "types": "./dist/shade/typed.d.ts",
      "import": "./dist/shade/index.js"
    },
    "./shade/untyped": {
      "types": "./dist/shade/index.d.ts",
      "import": "./dist/shade/index.js"
    },
    "./material": {
      "types": "./dist/material/typed.d.ts",
      "import": "./dist/material/index.js"
    },
    "./material/untyped": {
      "types": "./dist/material/index.d.ts",
      "import": "./dist/material/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  }
}

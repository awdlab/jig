{
  "name": "@awdlab/jig-custom-types",
  "version": "0.0.1-next.0",
  "description": "Shared TypeScript type contracts used across @awdlab/jig and its themes.",
  "license": "MIT",
  "homepage": "https://jig.awdlab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awdlab/jig.git",
    "directory": "packages/custom-types"
  },
  "keywords": [
    "angular",
    "types",
    "typescript",
    "awdlab",
    "jig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm rimraf ./dist",
    "postbuild": "tsx ./tools/post-build.ts",
    "build": "pnpm prebuild && tsc -p ./tsconfig.lib.json --outDir ./dist && pnpm postbuild"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "catalog:"
  },
  "sideEffects": true
}

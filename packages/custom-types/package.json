{
  "name": "@awdlab/jig-custom-types",
  "version": "0.0.2",
  "description": "Shared TypeScript type contracts used across @awdlab/jig and its themes.",
  "license": "MIT",
  "homepage": "https://jig.awdlab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awdlab/jig.git",
    "directory": "packages/custom-types"
  },
  "keywords": [
    "angular",
    "types",
    "typescript",
    "awdlab",
    "jig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:pre": "pnpm rimraf ./dist",
    "build": "pnpm build:pre && tsc -p ./tsconfig.lib.json --outDir ./dist && pnpm build:post",
    "build:post": "cpy ../../LICENSE ."
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}

{
  "source": "angular-material",
  "label": "Angular Material",
  "notes": "Material wraps most form controls in <mat-form-field>; the ngn equivalent is ngn-input-field. Material uses [(ngModel)] or formControlName; ngn controls expose a signal `value` model ([(value)]) and also integrate with reactive forms. Material's `matX` attribute directives map to ngn attribute directives (e.g. matInput -> ngnInput). Verify target inputs with get_control before rewriting.",
  "components": [
    {
      "from": "button[mat-button] / mat-raised-button",
      "to": "button[ngnButton]",
      "props": [
        { "from": "color", "to": "kind / color" },
        { "from": "disabled", "to": "[disabled] (native attribute)" }
      ]
    },
    {
      "from": "mat-form-field",
      "to": "ngn-input-field",
      "notes": "Wraps a form control and provides label/hint/error chrome.",
      "props": [
        { "from": "mat-label", "to": "label" },
        { "from": "mat-hint", "to": "hint (ngn-hint)" },
        { "from": "mat-error", "to": "error / validation" }
      ]
    },
    {
      "from": "input[matInput]",
      "to": "input[ngnInput]",
      "notes": "Move any `id` off the input onto the wrapper: `<ngn-input-field [inputId]=\"'old-id'\">` — the field overwrites an id left on the projected input, breaking external `<label for>` / `aria-describedby` references.",
      "props": [{ "from": "[(ngModel)]", "to": "[(value)] or formControl" }]
    },
    {
      "from": "mat-select",
      "to": "ngn-select",
      "props": [
        { "from": "[(ngModel)] / value", "to": "[(value)]" },
        { "from": "multiple", "to": "multiple" },
        {
          "from": "mat-option",
          "to": "options input",
          "notes": "ngn-select takes an options array; verify template projection with get_control."
        }
      ]
    },
    {
      "from": "mat-checkbox",
      "to": "ngn-checkbox",
      "props": [{ "from": "[(ngModel)] / checked", "to": "[(value)]" }]
    },
    {
      "from": "mat-radio-group / mat-radio-button",
      "to": "ngn-radio-group / ngn-radio",
      "props": [{ "from": "[(ngModel)]", "to": "[(value)] on the group" }]
    },
    {
      "from": "mat-slide-toggle",
      "to": "ngn-switch",
      "props": [{ "from": "[(ngModel)] / checked", "to": "[(value)]" }]
    },
    {
      "from": "mat-slider",
      "to": "ngn-slider",
      "props": [{ "from": "min / max / step", "to": "min / max / step" }]
    },
    {
      "from": "mat-datepicker + matDatepicker",
      "to": "ngn-calendar",
      "notes": "Single-component picker in ngn; no separate toggle/panel wiring.",
      "props": [{ "from": "[(ngModel)]", "to": "[(value)]" }]
    },
    {
      "from": "mat-dialog (MatDialog service)",
      "to": "ngn-dialog",
      "notes": "ngn-dialog is a declarative component with an [(open)] model, not primarily a service-opened overlay. Migrate imperatively-opened dialogs to declarative open state where possible.",
      "gaps": [
        "Service-based programmatic dialog opening differs from Material's MatDialog.open()."
      ]
    },
    {
      "from": "mat-sidenav / mat-drawer",
      "to": "ngn-drawer",
      "props": [{ "from": "[(opened)]", "to": "[(open)]" }]
    },
    {
      "from": "matTooltip",
      "to": "[ngnTooltip]",
      "props": [
        { "from": "matTooltip", "to": "ngnTooltip" },
        { "from": "matTooltipPosition", "to": "ngnTooltipPlacement" }
      ]
    },
    {
      "from": "mat-menu / matMenuTriggerFor",
      "to": "ngn-menu",
      "notes": "Verify trigger + item model with get_control."
    },
    { "from": "mat-tab-group", "to": "ngn-tabs" },
    { "from": "mat-accordion / mat-expansion-panel", "to": "ngn-accordion / ngn-accordion-panel" },
    {
      "from": "mat-table",
      "to": "ngn-table",
      "gaps": ["Column/template model differs; migrate incrementally."]
    },
    {
      "from": "mat-paginator",
      "to": "ngn-paginator",
      "props": [
        { "from": "pageSize", "to": "pageSize" },
        { "from": "length", "to": "totalItems" }
      ]
    },
    { "from": "mat-tree", "to": "ngn-tree" },
    { "from": "mat-progress-bar", "to": "ngn-progress" },
    { "from": "mat-progress-spinner / mat-spinner", "to": "ngn-spinner" },
    { "from": "mat-chip-set / mat-chip", "to": "ngn-chip" },
    { "from": "mat-badge", "to": "ngn-tag" },
    {
      "from": "mat-icon",
      "to": "ngn-icon",
      "notes": "ngn uses iconify (tabler) icons; see the icons concept guide."
    },
    { "from": "mat-snack-bar", "to": "ngn-snackbar / ngn-toast" },
    { "from": "mat-breadcrumb (community)", "to": "ngn-breadcrumb" },
    {
      "from": "mat-button-toggle-group",
      "to": "ngn-select-button",
      "notes": "Use ngn-toggle-button for a single toggle.",
      "props": [{ "from": "[(value)]", "to": "[(value)]" }]
    },
    {
      "from": "mat-list / mat-selection-list",
      "to": "ngn-list-box",
      "props": [
        { "from": "[(ngModel)]", "to": "[(value)]" },
        { "from": "multiple", "to": "multiple" }
      ]
    },
    {
      "from": "mat-card",
      "to": "(no direct equivalent)",
      "gaps": [
        "No card container control; compose with plain elements + Tailwind and ngn controls inside."
      ]
    },
    {
      "from": "mat-stepper",
      "to": "(no direct equivalent)",
      "gaps": [
        "No stepper/wizard control; drive steps with a signal and conditionally render ngn controls (see the build_feature workflow)."
      ]
    }
  ]
}

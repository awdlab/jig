{
  "source": "angular-material",
  "label": "Angular Material",
  "notes": "Material wraps most form controls in <mat-form-field>; the awd equivalent is awd-input-field. Material uses [(ngModel)] or formControlName; awd controls expose a signal `value` model ([(value)]) and also integrate with reactive forms. Material's `matX` attribute directives map to awd attribute directives (e.g. matInput -> ngnInput). Verify target inputs with get_control before rewriting.",
  "components": [
    {
      "from": "button[mat-button] / mat-raised-button",
      "to": "button[ngnButton]",
      "props": [
        { "from": "color", "to": "kind / color" },
        { "from": "disabled", "to": "[disabled] (native attribute)" }
      ]
    },
    {
      "from": "mat-form-field",
      "to": "awd-input-field",
      "notes": "Wraps a form control and provides label/hint/error chrome.",
      "props": [
        { "from": "mat-label", "to": "label" },
        { "from": "mat-hint", "to": "hint (awd-hint)" },
        { "from": "mat-error", "to": "error / validation" }
      ]
    },
    {
      "from": "input[matInput]",
      "to": "input[ngnInput]",
      "notes": "Move any `id` off the input onto the wrapper: `<awd-input-field [inputId]=\"'old-id'\">` — the field overwrites an id left on the projected input, breaking external `<label for>` / `aria-describedby` references.",
      "props": [{ "from": "[(ngModel)]", "to": "[(value)] or formControl" }]
    },
    {
      "from": "mat-select",
      "to": "awd-select",
      "props": [
        { "from": "[(ngModel)] / value", "to": "[(value)]" },
        { "from": "multiple", "to": "multiple" },
        {
          "from": "mat-option",
          "to": "options input",
          "notes": "awd-select takes an options array; verify template projection with get_control."
        }
      ]
    },
    {
      "from": "mat-checkbox",
      "to": "awd-checkbox",
      "props": [{ "from": "[(ngModel)] / checked", "to": "[(value)]" }]
    },
    {
      "from": "mat-radio-group / mat-radio-button",
      "to": "awd-radio-group / awd-radio",
      "props": [{ "from": "[(ngModel)]", "to": "[(value)] on the group" }]
    },
    {
      "from": "mat-slide-toggle",
      "to": "awd-switch",
      "props": [{ "from": "[(ngModel)] / checked", "to": "[(value)]" }]
    },
    {
      "from": "mat-slider",
      "to": "awd-slider",
      "props": [{ "from": "min / max / step", "to": "min / max / step" }]
    },
    {
      "from": "mat-datepicker + matDatepicker",
      "to": "awd-calendar",
      "notes": "Single-component picker in awd; no separate toggle/panel wiring.",
      "props": [{ "from": "[(ngModel)]", "to": "[(value)]" }]
    },
    {
      "from": "mat-dialog (MatDialog service)",
      "to": "awd-dialog",
      "notes": "awd-dialog is a declarative component with an [(open)] model, not primarily a service-opened overlay. Migrate imperatively-opened dialogs to declarative open state where possible.",
      "gaps": [
        "Service-based programmatic dialog opening differs from Material's MatDialog.open()."
      ]
    },
    {
      "from": "mat-sidenav / mat-drawer",
      "to": "awd-drawer",
      "props": [{ "from": "[(opened)]", "to": "[(open)]" }]
    },
    {
      "from": "matTooltip",
      "to": "[ngnTooltip]",
      "props": [
        { "from": "matTooltip", "to": "ngnTooltip" },
        { "from": "matTooltipPosition", "to": "ngnTooltipPlacement" }
      ]
    },
    {
      "from": "mat-menu / matMenuTriggerFor",
      "to": "awd-menu",
      "notes": "Verify trigger + item model with get_control."
    },
    { "from": "mat-tab-group", "to": "awd-tabs" },
    { "from": "mat-accordion / mat-expansion-panel", "to": "awd-accordion / awd-accordion-panel" },
    {
      "from": "mat-table",
      "to": "awd-table",
      "gaps": ["Column/template model differs; migrate incrementally."]
    },
    {
      "from": "mat-paginator",
      "to": "awd-paginator",
      "props": [
        { "from": "pageSize", "to": "pageSize" },
        { "from": "length", "to": "totalItems" }
      ]
    },
    { "from": "mat-tree", "to": "awd-tree" },
    { "from": "mat-progress-bar", "to": "awd-progress" },
    { "from": "mat-progress-spinner / mat-spinner", "to": "awd-spinner" },
    { "from": "mat-chip-set / mat-chip", "to": "awd-chip" },
    {
      "from": "matBadge",
      "to": "[ngnBadge]",
      "notes": "Attribute directive overlaying a counter/dot on its host, like matBadge; awd-badge-indicator is the standalone element form. Use awd-tag for a standalone label chip.",
      "props": [
        { "from": "matBadge", "to": "[ngnBadge]" },
        { "from": "matBadgePosition", "to": "[ngnBadgePosition]" },
        { "from": "matBadgeHidden", "to": "[ngnBadgeHidden]" },
        { "from": "matBadgeColor", "to": "kind / color" }
      ]
    },
    {
      "from": "mat-icon",
      "to": "awd-icon",
      "notes": "awd uses iconify (tabler) icons; see the icons concept guide."
    },
    { "from": "mat-snack-bar", "to": "awd-snackbar / awd-toast" },
    { "from": "mat-breadcrumb (community)", "to": "awd-breadcrumb" },
    {
      "from": "mat-button-toggle-group",
      "to": "awd-select-button",
      "notes": "Use awd-toggle-button for a single toggle.",
      "props": [{ "from": "[(value)]", "to": "[(value)]" }]
    },
    {
      "from": "mat-list / mat-selection-list",
      "to": "awd-list-box",
      "props": [
        { "from": "[(ngModel)]", "to": "[(value)]" },
        { "from": "multiple", "to": "multiple" }
      ]
    },
    {
      "from": "mat-card",
      "to": "(no direct equivalent)",
      "gaps": [
        "No card container control; compose with plain elements + Tailwind and awd controls inside."
      ]
    },
    {
      "from": "mat-stepper / mat-horizontal-stepper / mat-vertical-stepper",
      "to": "awd-stepper / awd-step",
      "notes": "Steps are <awd-step> children; the active index is a signal model. Step content is lazy and cached by default ([lazy], [cache]).",
      "props": [
        { "from": "[(selectedIndex)]", "to": "[(active)]" },
        { "from": "linear", "to": "linear" },
        { "from": "mat-step label", "to": "label" },
        { "from": "optional", "to": "optional" },
        { "from": "completed", "to": "[(completed)]" },
        { "from": "hasError", "to": "error" }
      ],
      "gaps": [
        "No stepper-scoped form validation — awd-step exposes [completed]/[error] that you drive from your own form state."
      ]
    }
  ]
}

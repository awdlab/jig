{
  "source": "syncfusion",
  "label": "Syncfusion (Essential JS 2 for Angular)",
  "notes": "STARTER MAP — covers common Syncfusion Angular components; not yet exhaustive. Syncfusion uses `ejs-*` selectors and binds with [(value)] or [(ngModel)]. Map [(value)] to jig's [(value)] signal model. Many Syncfusion components are highly configurable; always verify the jig target's capabilities with get_control and flag gaps rather than assuming parity.",
  "components": [
    {
      "from": "ejs-dropdownlist",
      "to": "jig-select",
      "props": [
        { "from": "[(value)]", "to": "[(value)]" },
        { "from": "dataSource", "to": "options" },
        { "from": "allowFiltering", "to": "filter" },
        {
          "from": "fields",
          "to": "templateItem",
          "notes": "jig-select derives label/value from the item shape or a templateItem, not a fields map."
        }
      ]
    },
    { "from": "ejs-multiselect", "to": "jig-select", "notes": "Use jig-select with multiple." },
    {
      "from": "ejs-combobox / ejs-autocomplete",
      "to": "jig-select",
      "notes": "Use editable jig-select."
    },
    {
      "from": "ejs-datepicker / ejs-datetimepicker",
      "to": "jig-calendar",
      "props": [
        { "from": "[(value)]", "to": "[(value)]" },
        { "from": "min / max", "to": "min / max" }
      ]
    },
    {
      "from": "ejs-checkbox",
      "to": "jig-checkbox",
      "props": [{ "from": "[(checked)]", "to": "[(value)]" }]
    },
    { "from": "ejs-radiobutton", "to": "jig-radio", "notes": "Group with jig-radio-group." },
    {
      "from": "ejs-textbox",
      "to": "input[ngnInput]",
      "notes": "Wrap in jig-input-field. Move any `id` off the input onto the wrapper: `<jig-input-field [inputId]=\"'old-id'\">` — the field overwrites an id left on the projected input, breaking external `<label for>` / `aria-describedby` references."
    },
    {
      "from": "ejs-numerictextbox",
      "to": "input[ngnNumberInput]",
      "props": [
        { "from": "[(value)]", "to": "[(value)]" },
        { "from": "min", "to": "min" },
        { "from": "max", "to": "max" },
        { "from": "step", "to": "step" },
        { "from": "format", "to": "formatOptions", "notes": "Use Intl formatOptions." }
      ]
    },
    {
      "from": "ejs-maskedtextbox",
      "to": "jig-mask-input",
      "props": [{ "from": "mask", "to": "mask" }]
    },
    { "from": "ejs-switch", "to": "jig-switch" },
    {
      "from": "ejs-slider",
      "to": "jig-slider",
      "props": [{ "from": "min / max / step", "to": "min / max / step" }]
    },
    { "from": "ejs-listbox", "to": "jig-list-box" },
    {
      "from": "ejs-dialog",
      "to": "jig-dialog",
      "props": [{ "from": "[(visible)]", "to": "[(open)]" }],
      "gaps": ["Service/programmatic dialog usage differs from jig's declarative [(open)]."]
    },
    { "from": "ejs-sidebar", "to": "jig-drawer" },
    { "from": "ejs-tooltip", "to": "[ngnTooltip]" },
    { "from": "ejs-menu / ejs-contextmenu", "to": "jig-menu" },
    { "from": "ejs-breadcrumb", "to": "jig-breadcrumb" },
    { "from": "ejs-tab", "to": "jig-tabs" },
    { "from": "ejs-accordion", "to": "jig-accordion" },
    {
      "from": "ejs-grid",
      "to": "jig-table",
      "gaps": [
        "Syncfusion Grid is very feature-rich (grouping, editing, virtualization, export). Verify each feature against jig-table; expect gaps."
      ]
    },
    { "from": "ejs-pager", "to": "jig-paginator" },
    { "from": "ejs-treeview", "to": "jig-tree" },
    { "from": "ejs-progressbar", "to": "jig-progress" },
    { "from": "ejs-chip / ejs-chiplist", "to": "jig-chip" },
    { "from": "ejs-avatar (CSS)", "to": "jig-avatar" },
    { "from": "ejs-toast", "to": "jig-toast / jig-snackbar" },
    { "from": "ejs-message", "to": "jig-message" },
    { "from": "ejs-uploader", "to": "jig-upload" },
    { "from": "ejs-splitter", "to": "jig-splitter" },
    {
      "from": "ejs-rating",
      "to": "jig-rating",
      "props": [
        { "from": "[(value)]", "to": "[(value)]" },
        { "from": "itemsCount", "to": "count" },
        { "from": "precision", "to": "step", "notes": "Half stars = step 0.5." },
        { "from": "allowReset", "to": "clearable" }
      ]
    },
    {
      "from": "ejs-stepper",
      "to": "jig-stepper / jig-step",
      "notes": "Steps are <jig-step> children, not a `steps` array input.",
      "props": [
        { "from": "[(activeStep)]", "to": "[(active)]" },
        { "from": "linear", "to": "linear" },
        { "from": "steps[].label", "to": "label" },
        { "from": "steps[].optional", "to": "optional" }
      ]
    },
    {
      "from": "ejs-colorpicker",
      "to": "jig-color-picker",
      "props": [
        { "from": "[(value)]", "to": "[(value)]" },
        { "from": "mode / modeSwitcher", "to": "format" },
        { "from": "inline", "to": "inline" },
        { "from": "presetColors", "to": "swatches" },
        { "from": "noColor / enableOpacity", "to": "alpha" }
      ]
    },
    {
      "from": "ejs-otpinput",
      "to": "jig-otp",
      "notes": "Grouped control with no single focusable element — label it with [labelledBy].",
      "props": [
        { "from": "[(value)]", "to": "[(value)]" },
        { "from": "length", "to": "length" },
        { "from": "type='password'", "to": "mask" },
        { "from": "type='number'", "to": "integerOnly" }
      ]
    },
    {
      "from": "ejs-inplaceeditor",
      "to": "jig-edit-inplace",
      "notes": "Wraps the editor control you project; jig-inplace is the lower-level display/edit swap."
    },
    {
      "from": "ejs-keyboard",
      "to": "[ngnKeyboardShortcut]",
      "notes": "Scope directive: shortcuts fire while focus is inside the host (or globally per binding). jig-kbd renders the shortcut glyphs."
    }
  ]
}

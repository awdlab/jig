{
  "name": "@ngneers/controls-mcp",
  "version": "0.0.1",
  "description": "Model Context Protocol server exposing @ngneers/controls docs, API and concepts to AI coding agents.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://ngneers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NGneers/controls.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "angular",
    "mcp",
    "model-context-protocol",
    "ai",
    "ngneers-controls"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ngneers-controls-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "skills",
    "README.md"
  ],
  "scripts": {
    "prebuild:pack": "pnpm --filter @ngneers/controls api-docs:generate",
    "build:pack": "tsx scripts/build-pack.ts",
    "build:server": "tsc -p tsconfig.json",
    "build": "pnpm build:pack && pnpm build:server",
    "start": "tsx src/index.ts",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "awesome-logging": "^2.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  }
}

{
  "name": "@awdlab/jig-playwright",
  "version": "0.0.9",
  "description": "Playwright testing harness with page-object helpers for @awdlab/jig components.",
  "license": "MIT",
  "homepage": "https://jig.awdlab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awdlab/jig.git",
    "directory": "packages/playwright"
  },
  "keywords": [
    "angular",
    "playwright",
    "testing",
    "e2e",
    "page-object",
    "awdlab",
    "jig"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:pre": "pnpm rimraf ./dist",
    "build": "pnpm build:pre && tsc -p ./tsconfig.lib.json && pnpm build:post",
    "build:post": "cpy ../../LICENSE ."
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@awdlab/jig": "workspace:*",
    "@awdlab/jig-themes": "workspace:*",
    "@playwright/test": ">=1.55.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "rimraf": "^6.1.3",
    "typescript": "catalog:"
  }
}

{
  "name": "@awdlab/jig-docs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "serve": "pnpm prepare-docs && ng serve",
    "build": "pnpm prepare-docs && ng build",
    "prepare-docs": "pnpm --filter @awdlab/jig api-docs:generate && pnpm api:links && pnpm seo:gen && pnpm search:model && pnpm search:index",
    "api:links": "tsx tools/api-links-gen.ts",
    "seo:gen": "tsx tools/seo-gen.ts",
    "search:index": "tsx tools/search-index-gen.ts",
    "search:check": "tsx tools/search-check.ts",
    "search:model": "tsx tools/quantize-potion.ts",
    "search:model:verify": "tsx tools/quantize-potion.ts --verify"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-server": "catalog:",
    "@angular/router": "catalog:",
    "@angular/ssr": "catalog:",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ngneers/signal-translate": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "postcss": "^8.5.26",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20"
  },
  "devDependencies": {
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@huggingface/transformers": "^4.3.1",
    "@iconify/icons-tabler": "^1.2.95",
    "@iconify/types": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "typescript": "catalog:"
  }
}

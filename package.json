{
  "name": "@ngneers/controls-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prettier": "node --experimental-strip-types node_modules/prettier/bin/prettier.cjs",
    "docs:serve": "pnpm --filter @ngneers/controls-docs serve",
    "test-wrapper:serve": "pnpm --filter @ngneers/test-wrapper serve",
    "isolated:serve": "pnpm --filter @ngneers/isolated serve",
    "docs:build": "pnpm --filter @ngneers/controls-docs build",
    "controls:build": "pnpm --filter @ngneers/controls build",
    "themes:build": "pnpm --filter @ngneers/controls-themes build",
    "types:build": "pnpm --filter @ngneers/controls-custom-types build",
    "icons:generate": "pnpm --filter @ngneers/controls icons:generate",
    "api-docs:generate": "pnpm --filter @ngneers/controls api-docs:generate",
    "build": "pnpm -r build",
    "format": "pnpm prettier --write \"**/*.{ts,html,json,md}\"",
    "format:check": "pnpm prettier --check \"**/*.{ts,html,json,md}\"",
    "lint": "pnpm -r lint",
    "playwright-docker": "docker run --add-host=hostmachine:host-gateway -p 3000:3000 --rm --init -it --workdir /home/pwuser --user pwuser mcr.microsoft.com/playwright:v1.58.0-noble /bin/sh -c \"npx -y playwright@1.58.0 run-server --port 3000 --host 0.0.0.0\"",
    "run-migrations": "tsx ./tools/migrate.ts",
    "test": "pnpm playwright test",
    "test:build": "pnpm tsgo --noEmit --project tests/tsconfig.test.json",
    "test:ui": "pnpm playwright test --ui",
    "unit-test": "pnpm -r test"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.1",
    "@eslint/js": "^10.0.1",
    "@ngneers/eslint-config": "^2.0.1",
    "@ngneers/eslint-config-angular": "^2.0.0",
    "@ngneers/prettier-config": "^1.1.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260318.1",
    "@vitest/coverage-v8": "^4.1.0",
    "angular-eslint": "21.3.1",
    "awesome-logging": "^2.0.3",
    "cpy-cli": "^7.0.0",
    "eslint": "10.0.3",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "json5": "^2.2.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typescript": "catalog:",
    "typescript-eslint": "^8.57.1",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}

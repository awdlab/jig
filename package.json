{
  "name": "@ngneers/controls-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prettier": "node --experimental-strip-types node_modules/prettier/bin/prettier.cjs",
    "docs:serve": "pnpm --filter @ngneers/controls-docs serve",
    "test-wrapper:serve": "pnpm --filter @ngneers/test-wrapper serve",
    "isolated:serve": "pnpm --filter @ngneers/isolated serve",
    "docs:build": "pnpm --filter @ngneers/controls-docs build",
    "controls:build": "pnpm --filter @ngneers/controls build",
    "themes:build": "pnpm --filter @ngneers/controls-themes build",
    "types:build": "pnpm --filter @ngneers/controls-custom-types build",
    "mcp:build": "pnpm --filter @ngneers/controls-mcp build",
    "api-docs:generate": "pnpm --filter @ngneers/controls api-docs:generate",
    "build": "pnpm -r build",
    "format": "pnpm prettier --write \"**/*.{ts,html,json,md}\" --ignore-path .gitignore",
    "format:check": "pnpm prettier --check \"**/*.{ts,html,json,md}\"",
    "lint": "pnpm -r lint",
    "playwright-docker": "docker run --add-host=hostmachine:host-gateway -p 3000:3000 --rm --init -it --workdir /home/pwuser --user pwuser mcr.microsoft.com/playwright:v1.61.0-noble /bin/sh -c \"npx -y playwright@1.61.0 run-server --port 3000 --host 0.0.0.0\"",
    "run-migrations": "tsx ./tools/migrate.ts",
    "test": "pnpm playwright test",
    "test:build": "pnpm tsc --noEmit --project tests/tsconfig.test.json",
    "test:ui": "pnpm playwright test --ui",
    "unit-test": "pnpm -r test"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@ngneers/eslint-config": "^3.1.1",
    "@ngneers/eslint-config-angular": "^3.0.0",
    "@ngneers/prettier-config": "^1.1.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "22.0.0",
    "awesome-logging": "^2.1.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "json5": "^2.2.3",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.0",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "typescript-eslint": "^8.63.0",
    "yaml": "^2.9.0"
  }
}

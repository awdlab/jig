{
  "name": "@ngneers/controls-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docs:serve": "pnpm --filter @ngneers/controls-docs serve",
    "test-wrapper:serve": "pnpm --filter @ngneers/test-wrapper serve",
    "docs:build": "pnpm --filter @ngneers/controls-docs build",
    "controls:build": "pnpm --filter @ngneers/controls build",
    "themes:build": "pnpm --filter @ngneers/controls-themes build",
    "api-docs:generate": "pnpm --filter @ngneers/controls api-docs:generate",
    "build": "pnpm -r build",
    "format": "pnpm prettier --write \"**/*.{ts,html,json,md}\"",
    "format:check": "pnpm prettier --check \"**/*.{ts,html,json,md}\"",
    "lint": "pnpm -r lint",
    "playwright-docker": "docker run --add-host=hostmachine:host-gateway -p 3000:3000 --rm --init -it --workdir /home/pwuser --user pwuser mcr.microsoft.com/playwright:v1.54.2-noble /bin/sh -c \"npx -y playwright@1.54.2 run-server --port 3000 --host 0.0.0.0\"",
    "playwright:fix-screenshots": "node --experimental-strip-types ./tools/fix-playwright-screenshots.ts",
    "test": "pnpm playwright test"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@angular-eslint/builder": "^20.1.1",
    "@eslint/js": "^9.30.0",
    "@ngneers/eslint-config": "^2.0.1",
    "@ngneers/eslint-config-angular": "^2.0.0",
    "@ngneers/prettier-config": "^1.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.0.7",
    "angular-eslint": "20.1.1",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.10",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript-eslint": "^8.35.0"
  }
}
{
  "name": "@awdlab/jig-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prettier": "node --experimental-strip-types node_modules/prettier/bin/prettier.cjs",
    "changeset": "pnpm exec awesome-publish changeset",
    "docs:serve": "pnpm --filter @awdlab/jig-docs serve",
    "test-wrapper:serve": "pnpm --filter @awdlab/test-wrapper serve",
    "isolated:serve": "pnpm --filter @awdlab/isolated serve",
    "docs:build": "pnpm --filter @awdlab/jig-docs build",
    "search:check": "pnpm --filter @awdlab/jig-docs search:check",
    "controls:build": "pnpm --filter @awdlab/jig build",
    "themes:build": "pnpm --filter @awdlab/jig-themes build",
    "types:build": "pnpm --filter @awdlab/jig-custom-types build",
    "mcp:build": "pnpm --filter @awdlab/jig-mcp build",
    "pw:build": "pnpm --filter @awdlab/jig-playwright build",
    "api-docs:generate": "pnpm --filter @awdlab/jig api-docs:generate",
    "build": "pnpm -r build",
    "format": "oxfmt \"**/*.{ts,json,md}\" && pnpm format:html",
    "format:html": "pnpm prettier --write \"**/*.html\" --ignore-path .gitignore",
    "format:check": "oxfmt --check \"**/*.{ts,json,md}\" && pnpm prettier --check \"**/*.html\" --ignore-path .gitignore",
    "lint": "oxlint --type-aware",
    "check:changed": "tsx tools/lint-changed.ts",
    "fix:changed": "tsx tools/lint-changed.ts --format-fix --lint-fix",
    "playwright-docker": "docker run --add-host=hostmachine:host-gateway -p 3000:3000 --rm --init -it --workdir /home/pwuser --user pwuser mcr.microsoft.com/playwright:v1.62.1-noble /bin/sh -c \"npx -y playwright@1.62.1 run-server --port 3000 --host 0.0.0.0\"",
    "run-migrations": "tsx ./tools/migrate.ts",
    "test": "pnpm playwright test",
    "test:build": "pnpm tsc --noEmit --project tests/tsconfig.test.json",
    "test:ui": "pnpm playwright test --ui",
    "unit-test": "pnpm -r test",
    "prepare": "husky"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@ngneers/prettier-config": "^1.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "awesome-logging": "^2.1.1",
    "awesome-publish": "^0.0.7",
    "cpy-cli": "^7.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "json5": "^2.2.3",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.11",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "yaml": "^2.9.0"
  }
}

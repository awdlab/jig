{
  "name": "@ngneers/controls-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docs:serve": "pnpm --filter @ngneers/controls-docs serve",
    "test-wrapper:serve": "pnpm --filter @ngneers/test-wrapper serve",
    "docs:build": "pnpm --filter @ngneers/controls-docs build",
    "controls:build": "pnpm --filter @ngneers/controls build",
    "themes:build": "pnpm --filter @ngneers/controls-themes build",
    "types:build": "pnpm --filter @ngneers/controls-custom-types build",
    "api-docs:generate": "pnpm --filter @ngneers/controls api-docs:generate",
    "build": "pnpm -r build",
    "format": "pnpm prettier --write \"**/*.{ts,html,json,md}\"",
    "format:check": "pnpm prettier --check \"**/*.{ts,html,json,md}\"",
    "lint": "pnpm -r lint",
    "playwright-docker": "docker run --add-host=hostmachine:host-gateway -p 3000:3000 --rm --init -it --workdir /home/pwuser --user pwuser mcr.microsoft.com/playwright:v1.56.1-noble /bin/sh -c \"npx -y playwright@1.56.1 run-server --port 3000 --host 0.0.0.0\"",
    "playwright:fix-screenshots": "tsx ./tools/fix-playwright-screenshots.ts",
    "run-migrations": "tsx ./tools/migrate.ts",
    "test": "pnpm playwright test",
    "test:ui": "pnpm playwright test --ui"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@angular-eslint/builder": "^20.5.0",
    "@eslint/js": "^9.37.0",
    "@ngneers/eslint-config": "^2.0.1",
    "@ngneers/eslint-config-angular": "^2.0.0",
    "@ngneers/prettier-config": "^1.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.2",
    "angular-eslint": "20.5.0",
    "awesome-logging": "^2.0.3",
    "cpy-cli": "^6.0.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "json5": "^2.2.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "yaml": "^2.8.1"
  }
}
